# 32-byte AES key as hex (64 characters). Generate: openssl rand -hex 32
DECRYPTION_KEY_HEX=

# Optional Bearer token for MCP HTTP requests
MCP_API_KEY=

# Temp storage for decrypted files
TEMP_DIR=/tmp/dlp-mcp

# Limits
MAX_FILE_SIZE_MB=50
TEMP_TTL_SECONDS=3600

# Server port (fly.io sets PORT automatically)
PORT=8000
